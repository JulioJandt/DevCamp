# Copie este arquivo para ".env" e ajuste se necessário.
# Ao rodar via docker-compose, essas variáveis já são injetadas automaticamente
# no container da API (ver docker-compose.yml) — o .env só é necessário para
# rodar "node server.js" direto na máquina, fora do Docker.
# DB_PORT=5433 porque o docker-compose publica o Postgres do container nessa
# porta do host (5432 costuma já estar ocupada por uma instalação local).

DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=adminpassword
DB_NAME=devcamp
